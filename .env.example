# --- Google OAuth (NextAuth) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_URL=
NEXTAUTH_SECRET=

# --- Upstash Redis (התקדמות אישית + rate limiting) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Neon Postgres (סיפורים, מחשבון עלות, מודרציה) ---
# DATABASE_URL: מחרוזת ה-connection ה"pooled" מ-Neon — משמשת את האתר בזמן ריצה.
DATABASE_URL=
# DATABASE_URL_UNPOOLED: מחרוזת ה-connection הישירה (לא pooled) מ-Neon —
# משמשת רק את drizzle-kit להרצת מיגרציות (npm run db:generate / db:migrate).
DATABASE_URL_UNPOOLED=

# --- הרשאת מנהלת (מודרציית סיפורים) ---
# רשימת אימיילים של Google מופרדת בפסיקים, שיקבלו הרשאת אישור/דחיית סיפורים.
ADMIN_EMAILS=

# --- טופס "צרי קשר" (Resend) ---
# RESEND_API_KEY: מפתח מ-resend.com → API Keys.
# CONTACT_TO_EMAIL: לאן יישלחו ההודעות (במסלול בלי דומיין מאומת — רק המייל של חשבון Resend).
# CONTACT_FROM_EMAIL: לא חובה; אחרי אימות דומיין ב-Resend, למשל "מקפיאות <contact@yourdomain>".
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
